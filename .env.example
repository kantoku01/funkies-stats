# Supabase ダッシュボード > Project Settings > API Keys の値を入れて .env.local として保存する
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...)。旧形式の anon key でも動く
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- LINE の自動送信(使うときだけ。README の「LINE の自動送信」参照) ---
# Supabase > Project Settings > API Keys の Secret key(sb_secret_...)。サーバーだけで使う
SUPABASE_SECRET_KEY=
# LINE Developers > チャネル > Messaging API 設定 / チャネル基本設定
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Vercel の定期実行が付ける合言葉(長いランダムな文字列)
CRON_SECRET=
